{
    "name": "omnimeet/direct",
    "type": "library",
    "description": "Omnimeet Direct: a video meeting from browser to browser (WebRTC) - two people, encrypted end to end, no third party, nothing recorded. The handshake's rules on a store the application provides, temporary TURN credentials for one's own relay (coturn's use-auth-secret), and the JavaScript engine, with no dependency.",
    "keywords": [
        "video",
        "webrtc",
        "peer-to-peer",
        "signaling",
        "turn",
        "coturn",
        "omnimeet",
        "usage-policy"
    ],
    "homepage": "https://github.com/glitchr-omnisense/omnimeet-direct",
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/omnimeet": "^1.0@dev"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnimeet\\Direct\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnimeet\\Direct\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        },
        "omnisense": {
            "policy": "policy.json"
        }
    },
    "config": {
        "sort-packages": true
    }
}
